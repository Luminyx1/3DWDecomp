#!/bin/sh
# After a commit: regenerate the progress website (site/index.html) from the
# report the pre-commit hook just made and upload it (tools/deploy_site.py,
# only when deploy.ini exists), then the Doxygen docs (doxygen/index.html).
# Enable with: git config core.hooksPath tools/hooks
cd "$(git rev-parse --show-toplevel)" || exit 0
mkdir -p build
PY=$(command -v python || command -v python3)
if [ -n "$PY" ] && [ -f build/report.json ]; then
    if "$PY" tools/website.py > build/website.log 2>&1; then
        echo "post-commit: site/index.html updated"
        ( "$PY" tools/deploy_site.py > build/deploy.log 2>&1 & )
    fi
fi
command -v doxygen > /dev/null 2>&1 || exit 0
( doxygen Doxyfile > build/doxygen.log 2>&1 & )
exit 0
