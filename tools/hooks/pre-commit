#!/bin/sh
# Update the progress table in README.md and include it in this commit.
# Enable with: git config core.hooksPath tools/hooks
# Skip once with: SKIP_PROGRESS=1 git commit ...
[ -n "$SKIP_PROGRESS" ] && exit 0
cd "$(git rev-parse --show-toplevel)" || exit 1
PY=$(command -v python || command -v python3)
if [ -z "$PY" ]; then
    echo "pre-commit: python not found, progress not updated" >&2
    exit 0
fi
mkdir -p build
echo "pre-commit: measuring progress (ninja all + objdiff report)..."
if "$PY" tools/progress.py > build/progress.log 2>&1; then
    git add README.md
    tail -n 1 build/progress.log
else
    echo "pre-commit: tools/progress.py failed, README not updated (see build/progress.log)" >&2
fi
exit 0
