#!/bin/sh
# Before a push: make sure the website is current and uploaded (commits made
# elsewhere and merged in never ran post-commit here).  Never blocks the push.
# Enable with: git config core.hooksPath tools/hooks
cd "$(git rev-parse --show-toplevel)" || exit 0
PY=$(command -v python || command -v python3)
[ -n "$PY" ] || exit 0
mkdir -p build
"$PY" tools/website.py > build/website.log 2>&1 || exit 0
"$PY" tools/deploy_site.py 2>&1 | tee build/deploy.log | tail -n 1
exit 0
