{
  "$comment": "Toolchain + compiler flags. Translation units live in splits.txt.",

  "toolchain": {
    "cc":  "tools/nnsdk/Compilers/NX/nx/aarch64/bin/clang.exe",
    "cxx": "tools/nnsdk/Compilers/NX/nx/aarch64/bin/clang++.exe",
    "target": "aarch64-nintendo-nx-elf"
  },

  "$flags_note": [
    "From the NintendoSDK manual, docs/nnsdk/.../Page_170694349.html:",
    "'Build Procedure: Creating the Object File'.",
    "Required: -std=gnu++14 -fno-common -fno-short-enums -ffunction-sections",
    "-fdata-sections -fPIC.  64-bit adds -mcpu=cortex-a57+fp+simd+crypto+crc.",
    "Retail builds: -O3 -fno-omit-frame-pointer, -DNN_SDK_BUILD_RELEASE.",
    "Prohibited: -fshort-wchar, -fpack-struct.  It is gnu++14, not 17."
  ],
  "flags": {
    "common": "-fPIC -fno-common -fno-short-enums -ffunction-sections -fdata-sections -fno-omit-frame-pointer -mcpu=cortex-a57+fp+simd+crypto+crc -DNN_NINTENDO_SDK -DNN_SDK_BUILD_RELEASE -g0 -Iinclude",
    "c":      "-O3 -std=gnu11",
    "cxx":    "-O3 -std=gnu++14"
  }
}
