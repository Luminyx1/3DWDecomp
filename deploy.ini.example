# Copy to deploy.ini (git-ignored) and fill in; used by tools/deploy_site.py
# and the git hooks to upload site/ to https://shibbo.net/3dw/.
[site]
# sftp, ftps (FTP over TLS) or ftp
protocol = sftp
host = ftp.example.com
# 22 for sftp, 21 for ftp/ftps
port = 22
user = username
# Leave empty and set the DEPLOY_PASSWORD environment variable instead if you
# prefer; for sftp you can use key_file instead of a password.
password =
# key_file = ~/.ssh/id_ed25519
# Folder on the server that https://shibbo.net/3dw/ serves (relative to the
# login folder, or absolute), e.g. public_html/3dw
remote_dir = public_html/3dw
# ftp/ftps only
passive = true
